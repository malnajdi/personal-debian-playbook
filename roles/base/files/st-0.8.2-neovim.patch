st 0.8.2 fixes for Neovim 0.12 (LazyVim)

1. A DCS string set term.mode to ESC_DCS. ESC_DCS has the same value as
   MODE_SIXEL, so st stopped to decode UTF-8 after the first DCS string, and
   showed "â" in place of lines and icons. st 0.8.3 has the same fix.
2. Answer the status report request (CSI 5 n). Neovim waits for this answer
   when it starts, and shows the error E1568 when there is no answer.

--- st.c
+++ st.c
@@ -1835,8 +1835,12 @@
 	case 'm': /* SGR -- Terminal attribute (color) */
 		tsetattr(csiescseq.arg, csiescseq.narg);
 		break;
-	case 'n': /* DSR – Device Status Report (cursor position) */
-		if (csiescseq.arg[0] == 6) {
+	case 'n': /* DSR – Device Status Report */
+		if (csiescseq.arg[0] == 5) {
+			/* Status report "OK" */
+			ttywrite("\033[0n", sizeof("\033[0n") - 1, 0);
+		} else if (csiescseq.arg[0] == 6) {
+			/* Cursor position */
 			len = snprintf(buf, sizeof(buf),"\033[%i;%iR",
 					term.c.y+1, term.c.x+1);
 			ttywrite(buf, len, 0);
@@ -1956,7 +1960,6 @@
 		xsettitle(strescseq.args[0]);
 		return;
 	case 'P': /* DCS -- Device Control String */
-		term.mode |= ESC_DCS;
 	case '_': /* APC -- Application Program Command */
 	case '^': /* PM -- Privacy Message */
 		return;
