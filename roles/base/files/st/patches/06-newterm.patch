+void
+newterm(const Arg* a)
+{
+	switch (fork()) {
+	case -1:
+		die("fork failed: %s\n", strerror(errno));
+		break;
+	case 0:
+		switch (fork()) {
+		case -1:
+			fprintf(stderr, "fork failed: %s\n", strerror(errno));
+			_exit(1);
+			break;
+		case 0: {
+			/* Run the real path of /proc/self/exe, so the
+			 * process name is "st" and not "exe". */
+			char exe[PATH_MAX];
+			ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+
+			chdir_by_pid(pid);
+			if (n > 0) {
+				exe[n] = '\0';
+				execl(exe, argv0, NULL);
+			}
+			execl("/proc/self/exe", argv0, NULL);
+			_exit(1);
+			break;
+		}
+		default:
+			_exit(0);
+		}
+	default:
+		wait(NULL);
+	}
+}
+
+static int
+chdir_by_pid(pid_t pid)
+{
+	char buf[32];
+	snprintf(buf, sizeof buf, "/proc/%ld/cwd", (long)pid);
+	return chdir(buf);
+}
