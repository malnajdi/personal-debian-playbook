Newterm: Ctrl+Shift+Return opens a new st in the directory of the shell.

Upstream: https://st.suckless.org/patches/newterm/st-newterm-0.9.diff
Changes: the hunks are fitted to the scrollback patch. newterm runs the real
path of /proc/self/exe, so the process name is "st" and not "exe".

diff --git a/config.def.h b/config.def.h
index f80ea01..ffc49d2 100644
--- a/config.def.h
+++ b/config.def.h
@@ -218,6 +218,7 @@ static Shortcut shortcuts[] = {
 	{ TERMMOD,              XK_Y,           selpaste,       {.i =  0} },
 	{ ShiftMask,            XK_Insert,      selpaste,       {.i =  0} },
 	{ TERMMOD,              XK_Num_Lock,    numlock,        {.i =  0} },
+	{ TERMMOD,              XK_Return,      newterm,        {.i =  0} },
 	{ ShiftMask,            XK_Page_Up,     kscrollup,      {.i = -1} },
     { ShiftMask,            XK_Page_Down,   kscrolldown,    {.i = -1} },
 };
