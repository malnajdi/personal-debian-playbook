#!/bin/bash
# Managed by Ansible
# Bluetooth menu with rofi: turn Bluetooth on or off, connect or disconnect a
# paired device, or scan for new devices and pair one.
# With the argument "toggle" it turns Bluetooth on or off without the menu.
# It needs bluetoothctl (bluez).

# Use the English bluetoothctl output for all locales
export LC_ALL=C.UTF-8

bt() {
    timeout 30 bluetoothctl "$@" </dev/null
}

# rofi prints the number of the selected line (from 0)
menu() {
    rofi -dmenu -i -format i -p "$1" -theme-str 'window { width: 480px; }'
}

notify() {
    notify-send -a "Bluetooth" "$@"
}

# Print "MAC Name" for each device in the bluetoothctl output
device_list() {
    awk '$1 == "Device" { $1 = ""; sub(/^ +/, ""); print }'
}

powered=$(bt show | awk '$1 == "Powered:" { print $2; exit }')

turn_on() {
    # rfkill is in /usr/sbin, which is not in the PATH of a normal user
    /usr/sbin/rfkill unblock bluetooth
    # The controller is ready a moment after rfkill unblock
    sleep 1
    bt power on >/dev/null || notify -u critical "Could not turn on Bluetooth"
}

if [ "$powered" != "yes" ]; then
    [ "$1" = "toggle" ] || [ "$(printf '%s\n' "  Turn Bluetooth on" | menu "Bluetooth")" = "0" ] && turn_on
    exit 0
fi

if [ "$1" = "toggle" ]; then
    bt power off >/dev/null
    exit 0
fi

mapfile -t paired < <(bt devices Paired | device_list)
connected=$(bt devices Connected | device_list | cut -d' ' -f1)

labels=("  Turn Bluetooth off" "  Scan for new devices")
for device in "${paired[@]}"; do
    if grep -qxF -- "${device%% *}" <<< "$connected"; then
        labels+=("󰂱  ${device#* }  (connected)")   # bluetooth connected icon
    else
        labels+=("󰂯  ${device#* }")                          # bluetooth icon
    fi
done

choice=$(printf '%s\n' "${labels[@]}" | menu "Bluetooth")
# Nothing selected, or a text that is not in the list
[ -n "$choice" ] && [ "$choice" -ge 0 ] || exit 0

case "$choice" in
    0)
        bt power off >/dev/null
        ;;
    1)
        # Scan and pair in one bluetoothctl session with a default agent. Pairing
        # fails (AuthenticationFailed) when each step runs in a new bluetoothctl.
        # BlueZ also forgets a new device 30 seconds after the scan stops, so the
        # scan goes on while the menu is open.
        session=$(mktemp -d)
        mkfifo "$session/in"
        timeout 300 bluetoothctl <"$session/in" >"$session/out" 2>&1 &
        exec 3>"$session/in"
        trap 'send quit 2>/dev/null; exec 3>&-; rm -rf "$session"' EXIT
        send() { printf '%s\n' "$*" >&3; }
        # The bluetoothctl output without colors
        output() { sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$session/out"; }

        # bluetoothctl registers its agent when it is connected to bluetoothd
        for (( i = 0; i < 20; i++ )); do
            output | grep -q 'Agent registered' && break
            sleep 0.5
        done
        send "default-agent"
        send "scan on"
        notify "Scanning for devices (10 seconds)"
        sleep 10
        # New devices with a name. A device without a name shows its address with "-".
        mapfile -t found < <(bt devices | device_list \
            | grep -vE '^([0-9A-F:]{17}) ([0-9A-F]{2}-){5}[0-9A-F]{2}$' \
            | grep -vF -f <(printf '%s\n' "${paired[@]%% *}" | grep .))
        if [ -z "${found[*]}" ]; then
            notify "No new devices found"
            exit 0
        fi
        labels=()
        for device in "${found[@]}"; do
            labels+=("󰂯  ${device#* }")
        done
        choice=$(printf '%s\n' "${labels[@]}" | menu "Pair")
        [ -n "$choice" ] && [ "$choice" -ge 0 ] || exit 0
        mac=${found[choice]%% *}
        name=${found[choice]#* }

        send "scan off"
        send "pair $mac"
        notify "Pairing with $name"
        # Wait up to 60 seconds. Answer "yes" to each question of the agent, and
        # show each passkey (a keyboard shows a passkey to type on it).
        result=""
        answered=0
        shown=0
        for (( i = 0; i < 120; i++ )); do
            out=$(output)
            result=$(grep -m 1 -E 'Pairing successful|Failed to pair' <<< "$out") && break
            questions=$(grep -cE 'Confirm passkey|Authorize|Accept pairing' <<< "$out")
            if [ "$questions" -gt "$answered" ]; then
                send "yes"
                answered=$questions
            fi
            passkeys=$(grep -oE 'Passkey: [0-9]+' <<< "$out")
            if [ "$(grep -c . <<< "$passkeys")" -gt "$shown" ]; then
                notify -u critical "Pairing with $name" "Type ${passkeys##*Passkey: } on the device, then press Enter"
                shown=$(grep -c . <<< "$passkeys")
            fi
            sleep 0.5
        done

        if [[ "$result" == *"Pairing successful"* ]]; then
            send "trust $mac"
            # A mouse or keyboard connects during the pairing
            if bt info "$mac" | grep -q 'Connected: yes' || bt connect "$mac" >/dev/null; then
                notify "Connected to $name"
            else
                notify "Paired with $name" "Select it in the menu to connect"
            fi
        else
            # For example "org.bluez.Error.AuthenticationFailed"
            reason=$(grep -o 'org\.bluez\.Error\.[A-Za-z]*' <<< "$result" | head -n 1)
            # Do not keep a device that is half paired
            send "remove $mac"
            notify -u critical "Could not pair with $name" "${reason#org.bluez.Error.}"
        fi
        sleep 1
        ;;
    *)
        device=${paired[choice - 2]}
        mac=${device%% *}
        name=${device#* }
        if grep -qxF -- "$mac" <<< "$connected"; then
            bt disconnect "$mac" >/dev/null && notify "Disconnected from $name"
        else
            notify "Connecting to $name"
            if bt connect "$mac" >/dev/null; then
                notify "Connected to $name"
            else
                notify -u critical "Could not connect to $name"
            fi
        fi
        ;;
esac
