myStartupHook :: X ()
myStartupHook = do
          -- Set the monitor layout first, then the wallpaper on each monitor
          spawnOnce "[ -f ~/.screenlayout/screen.sh ] && sh ~/.screenlayout/screen.sh; nitrogen --restore"
