-- Selected cell uses the accent color, other cells use the surface color
myColorizer :: a -> Bool -> X (String, String)
myColorizer _ True  = pure (colorAccent, colorCrust)
myColorizer _ False = pure (colorSurface0, colorText)

-- gridSelect menu layout
mygridConfig :: (a -> Bool -> X (String, String)) -> GSConfig a
mygridConfig colorizer = (buildDefaultGSConfig colorizer)
    { gs_cellheight   = 48
    , gs_cellwidth    = 280
    , gs_cellpadding  = 12
    , gs_originFractX = 0.5
    , gs_originFractY = 0.5
    , gs_font         = myFont
    , gs_bordercolor  = colorBase
    }

spawnSelected' :: [(String, String)] -> X ()
spawnSelected' lst = gridselect (mygridConfig myColorizer) lst >>= flip whenJust spawn

