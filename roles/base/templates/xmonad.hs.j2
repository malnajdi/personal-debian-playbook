-- The bar makes the workspaces clickable (needs xdotool), so the names stay plain.
myWorkspaces :: [String]
myWorkspaces = ["dev", "www", "sys", "repo", "ent", "rec", "draw"]

-- Nerd Font icon for each workspace in the bar
workspaceIcon :: String -> String
workspaceIcon ws = fromMaybe "\xf111" (lookup ws icons)
  where
    icons = [ ("dev",  "\xf121")   -- code
            , ("www",  "\xf0ac")   -- globe
            , ("sys",  "\xf120")   -- terminal
            , ("repo", "\xf126")   -- code fork
            , ("ent",  "\xf144")   -- play
            , ("rec",  "\xf03d")   -- video camera
            , ("draw", "\xf1fc")   -- paint brush
            ]

------------------------------------------------------------------------
-- MANAGEHOOK
------------------------------------------------------------------------
-- Sets some rules for certain programs. Examples include forcing certain
-- programs to always float, or to always appear on a certain workspace.
-- You need the className or title of the program. Use xprop to get this info.

-- Match the window class in lower case, because applications change the case between versions
classIs :: [String] -> Query Bool
classIs names = (`elem` names) . map toLower <$> className

myManageHook :: ManageHook
myManageHook = composeAll
     [ classIs ["obs"]                                    --> doShift "rec"
     , classIs ["firefox-esr", "firefox"]                 --> doShift "www"
     , classIs ["vlc"]                                    --> doShift "ent"
     , classIs ["gimp", "gimp-2.10", "gimp-3.0"]          --> doShift "draw"
     , classIs ["code"]                                   --> doShift "dev"
     , classIs ["pavucontrol", "org.pulseaudio.pavucontrol"] --> doCenterFloat
     , isDialog                                           --> doCenterFloat
     ]


------------------------------------------------------------------------
-- LAYOUTS
------------------------------------------------------------------------
-- Makes setting the spacingRaw simpler to write. The spacingRaw
-- module adds a configurable amount of space around windows.
mySpacing :: Integer -> l a -> XMonad.Layout.LayoutModifier.ModifiedLayout Spacing l a
mySpacing i = spacingRaw False (Border i i i i) True (Border i i i i) True

-- Defining a bunch of layouts, many that I don't use.
tall     = renamed [Replace "tall"]
           $ limitWindows 12
           $ mySpacing myGap
           $ ResizableTall 1 (3/100) (1/2) []
monocle  = renamed [Replace "monocle"]
           $ limitWindows 20
           $ mySpacing myGap
           $ Full
floats   = renamed [Replace "floats"]
           $ limitWindows 20
           $ simplestFloat
grid     = renamed [Replace "grid"]
           $ limitWindows 12
           $ mySpacing myGap
           $ mkToggle (single MIRROR)
           $ Grid (16/10)
tabs     = renamed [Replace "tabs"]
           -- Only a gap around the screen. A gap between the window
           -- and its tabs looks bad.
           $ spacingRaw False (Border g g g g) True (Border 0 0 0 0) False
           $ tabbed shrinkText myTabConfig
  where
    g = 2 * myGap
    myTabConfig = def { fontName            = myFont
                      , activeColor         = colorAccent
                      , inactiveColor       = colorSurface0
                      , urgentColor         = colorRed
                      , activeBorderColor   = colorAccent
                      , inactiveBorderColor = colorSurface0
                      , urgentBorderColor   = colorRed
                      , activeTextColor     = colorCrust
                      , inactiveTextColor   = colorText
                      , urgentTextColor     = colorCrust
                      , decoHeight          = 28
                      }

-- Big workspace name in the middle of the screen after a workspace change
mySWNConfig :: SWNConfig
mySWNConfig = def { swn_font    = "xft:{{ ui_font }}:bold:size=48"
                  , swn_fade    = 0.8
                  , swn_bgcolor = colorBase
                  , swn_color   = colorAccent
                  }

-- The layout hook
myLayoutHook = {% if xmonad_show_workspace_name %}showWName' mySWNConfig $ {% endif %}avoidStruts $ mouseResize $ windowArrange $ T.toggleLayouts floats $
               mkToggle (NBFULL ?? NOBORDERS ?? EOT) $ myDefaultLayout
             where
               -- I've commented out the layouts I don't use.
               myDefaultLayout =     tall
                                 ||| noBorders monocle
                                 ||| floats
                                 ||| grid
                                 ||| noBorders tabs

------------------------------------------------------------------------
-- STATUS BARS
------------------------------------------------------------------------
-- One xmobar on each screen. Screen 0 gets the primary bar and all other
-- screens get the compact bar. Bars come and go when you add or remove a monitor.
myStatusBar :: ScreenId -> IO StatusBarConfig
myStatusBar s@(S n) = statusBarPipe command (clickablePP (myPP s))
  where
    command = "xmobar -x " ++ show n ++ " " ++ config
    config
      | n == 0    = "{{ user_config_path }}/xmobar/xmobarrc"
      | otherwise = "{{ user_config_path }}/xmobar/xmobarrc-secondary"

myPP :: ScreenId -> PP
myPP s = def
    { ppCurrent         = pill colorCrust colorAccent                          -- Focused workspace
    , ppVisible         = xmobarBorder "Bottom" colorAccent 2 . xmobarColor colorAccent ""  -- Workspace on an other screen
    , ppHidden          = xmobarColor colorText ""                             -- Workspaces with windows
    , ppHiddenNoWindows = xmobarColor colorSurface2 ""                         -- Empty workspaces
    , ppUrgent          = pill colorCrust colorRed                             -- Urgent workspace
    , ppRename          = \ws _ -> workspaceLabel ws
    , ppWsSep           = " "
    , ppSep             = "  "
    , ppOrder           = \xs -> take 1 xs ++ drop 3 xs                       -- Workspaces, then the extras
    , ppExtras          = [layoutLogger s]
    }
  where
    primary = s == 0
    -- Solid color behind the text, from the top to the bottom of the bar.
    -- A space on each side, so the text does not touch the edge of the color.
    pill fg bg = wrap ("<fc=" ++ fg ++ "," ++ bg ++ ":0>") "</fc>" . wrap " " " "
    workspaceLabel ws
      | primary   = workspaceIcon ws ++ " " ++ ws
      | otherwise = workspaceIcon ws

-- Layout icon and name. Click it to change the layout.
layoutLogger :: ScreenId -> Logger
layoutLogger s = fmap (fmap label) (logLayoutOnScreen s)
  where
    label l = xmobarAction "xdotool key super+Tab" "1"
            $ xmobarColor colorBlue "" (layoutIcon l)
           ++ (if s == 0 then " " ++ xmobarColor colorSubtext "" l else "")

layoutIcon :: String -> String
layoutIcon l = fromMaybe "\xf0db" (lookup l icons)
  where
    icons = [ ("tall",    "\xf0db")   -- columns
            , ("monocle", "\xf2d0")   -- window maximize
            , ("floats",  "\xf2d2")   -- window restore
            , ("grid",    "\xf00a")   -- grid
            , ("tabs",    "\xf0c9")   -- bars
            , ("Full",    "\xf065")   -- expand
            ]

------------------------------------------------------------------------
-- Main
------------------------------------------------------------------------

main :: IO ()
main = do
    -- The bars get icons, so send UTF-8 to them for all locales
    setLocaleEncoding utf8
    xmonad
     . ewmhFullscreen
     . ewmh
     . docks
     . dynamicSBs myStatusBar
     $ def
        { manageHook         = ( isFullscreen --> doFullFloat ) <+> myManageHook
        , modMask            = myModMask
        , terminal           = myTerminal
        , startupHook        = myStartupHook
        , layoutHook         = myLayoutHook
        , workspaces         = myWorkspaces
        , borderWidth        = myBorderWidth
        , normalBorderColor  = myNormColor
        , focusedBorderColor = myFocusColor
        } `additionalKeysP` myKeys
