-- Nerd Font icon for each workspace in the bar
workspaceIcon :: String -> String
workspaceIcon ws = fromMaybe "\xf111" (lookup ws icons)
  where
    icons = [ ("dev",  "\xf121")   -- code
            , ("www",  "\xf0ac")   -- globe
            , ("sys",  "\xf120")   -- terminal
            , ("repo", "\xf126")   -- code fork
            , ("ent",  "\xf144")   -- play
            , ("rec",  "\xf03d")   -- video camera
            , ("draw", "\xf1fc")   -- paint brush
            ]

------------------------------------------------------------------------
-- MANAGEHOOK
------------------------------------------------------------------------
-- Sets some rules for certain programs. Examples include forcing certain
-- programs to always float, or to always appear on a certain workspace.
-- You need the className or title of the program. Use xprop to get this info.

-- Match the window class in lower case, because applications change the case between versions
classIs :: [String] -> Query Bool
classIs names = (`elem` names) . map toLower <$> className

myManageHook :: ManageHook
myManageHook = composeAll
     [ classIs ["obs"]                                    --> doShift "rec"
     , classIs ["firefox-esr", "firefox"]                 --> doShift "www"
     , classIs ["vlc"]                                    --> doShift "ent"
     , classIs ["gimp", "gimp-2.10", "gimp-3.0"]          --> doShift "draw"
     , classIs ["code"]                                   --> doShift "dev"
     , classIs ["pavucontrol", "org.pulseaudio.pavucontrol"] --> doCenterFloat
     , classIs ["flameshot"]                              --> doFloat   -- Pinned screenshots and settings
     , isDialog                                           --> doCenterFloat
     ]


------------------------------------------------------------------------
-- LAYOUTS
------------------------------------------------------------------------
-- Makes setting the spacingRaw simpler to write. The spacingRaw
-- module adds a configurable amount of space around windows.
mySpacing :: Integer -> l a -> XMonad.Layout.LayoutModifier.ModifiedLayout Spacing l a
mySpacing i = spacingRaw False (Border i i i i) True (Border i i i i) True

-- Defining a bunch of layouts, many that I don't use.
tall     = renamed [Replace "tall"]
           $ limitWindows 12
           $ mySpacing myGap
           $ ResizableTall 1 (3/100) (1/2) []
monocle  = renamed [Replace "monocle"]
           $ limitWindows 20
           $ mySpacing myGap
           $ Full
floats   = renamed [Replace "floats"]
           $ limitWindows 20
           $ simplestFloat
grid     = renamed [Replace "grid"]
           $ limitWindows 12
           $ mySpacing myGap
           $ mkToggle (single MIRROR)
           $ Grid (16/10)
tabs     = renamed [Replace "tabs"]
           -- Only a gap around the screen. A gap between the window
           -- and its tabs looks bad.
           $ spacingRaw False (Border g g g g) True (Border 0 0 0 0) False
           $ tabbed shrinkText myTabConfig
  where
    g = 2 * myGap
    -- The tabs have the background color of the window, so the tabs and the
    -- window look like one window. The active tab has an accent text and underline.
    myTabConfig = def { fontName            = myFont
                      , activeColor         = colorBase
                      , inactiveColor       = colorBase
                      , urgentColor         = colorBase
                      , activeBorderWidth   = 0
                      , inactiveBorderWidth = 0
                      , urgentBorderWidth   = 0
                      , activeTextColor     = colorAccent
                      , inactiveTextColor   = colorOverlay
                      , urgentTextColor     = colorRed
                      , decoHeight          = tabHeight
                      , windowTitleIcons    = [(underline, OffsetLeft 0 (fromIntegral tabHeight - 2))]
                      }
    tabHeight = 28
    -- A line of 2 pixels at the bottom of each tab, in the text color of the tab.
    -- It is wider than any screen; the tab cuts it to its own width.
    underline = replicate 2 (replicate 4000 True)

-- Windows in the tabs layout get the property _XMONAD_TABBED = 1, the other
-- windows on the screen get 0. picom draws the tabbed windows without rounded top
-- corners and shadow, so the window joins its tabs. The value changes to 0 (the
-- property stays), because picom 12 does not see that a property is deleted.
markTabbed :: X ()
markTabbed = withDisplay $ \dpy -> do
    atom <- getAtom "_XMONAD_TABBED"
    screens <- gets (W.screens . windowset)
    forM_ screens $ \scr -> do
        let ws    = W.workspace scr
            value = if description (W.layout ws) == "tabs" then 1 else 0
        forM_ (W.integrate' (W.stack ws)) $ \w -> do
            marked <- getProp32 atom w
            when (marked /= Just [value]) $
                io $ changeProperty32 dpy w atom cARDINAL propModeReplace [value]

-- Each visible tab gets the property _XMONAD_TAB_CORNERS: 1 for the first tab of a
-- row, 2 for the last tab, 3 for the only tab and 0 for the tabs between. picom
-- rounds only these outer corners, so the tabs and the window have one outline.
markTabCorners :: X ()
markTabCorners = withDisplay $ \dpy -> do
    atom <- getAtom "_XMONAD_TAB_CORNERS"
    root <- asks theRoot
    (_, _, children) <- io $ queryTree dpy root
    tabs <- fmap catMaybes . forM children $ \w -> do
        cls   <- io $ getClassHint dpy w
        -- A tab can close while xmonad reads it
        attrs <- catchX (Just <$> io (getWindowAttributes dpy w)) (return Nothing)
        return $ case attrs of
            Just wa | resName cls == "xmonad-decoration" && wa_map_state wa == waIsViewable
                -> Just (w, wa_x wa, wa_y wa, wa_width wa)
            _   -> Nothing
    forM_ tabs $ \(w, x, y, width) -> do
        -- Tabs of the same window touch each other on the same row
        let hasLeft  = any (\(_, x', y', w') -> y' == y && x' + w' == x) tabs
            hasRight = any (\(_, x', y', _)  -> y' == y && x' == x + width) tabs
            corners  = (if hasLeft then 0 else 1) + (if hasRight then 0 else 2)
        marked <- getProp32 atom w
        when (marked /= Just [corners]) $
            io $ changeProperty32 dpy w atom cARDINAL propModeReplace [corners]

-- Big workspace name in the middle of the screen after a workspace change
mySWNConfig :: SWNConfig
mySWNConfig = def { swn_font    = "xft:{{ ui_font }}:bold:size=48"
                  , swn_fade    = 0.8
                  , swn_bgcolor = colorBase
                  , swn_color   = colorAccent
                  }

-- The layout hook
myLayoutHook = {% if xmonad_show_workspace_name %}showWName' mySWNConfig $ {% endif %}avoidStruts $ mouseResize $ windowArrange $ T.toggleLayouts floats $
               mkToggle (NBFULL ?? NOBORDERS ?? EOT) $ myDefaultLayout
             where
               -- I've commented out the layouts I don't use.
               myDefaultLayout =     tall
                                 ||| noBorders monocle
                                 ||| floats
                                 ||| grid
                                 ||| noBorders tabs

------------------------------------------------------------------------
-- STATUS BARS
------------------------------------------------------------------------
-- One xmobar on each screen, all with the same bar.
-- Bars come and go when you add or remove a monitor.
myStatusBar :: ScreenId -> IO StatusBarConfig
myStatusBar s@(S n) = statusBarPipe command (clickablePP (myPP s))
  where
    command = "xmobar -x " ++ show n ++ " {{ user_config_path }}/xmobar/xmobarrc"

myPP :: ScreenId -> PP
myPP s = def
    { ppCurrent         = underlined colorAccent . xmobarColor colorAccent ""     -- Focused workspace
    , ppVisible         = underlined colorOverlay . xmobarColor colorText ""      -- Workspace on an other screen
    , ppHidden          = xmobarColor colorText ""                             -- Workspaces with windows
    , ppHiddenNoWindows = xmobarColor colorSurface2 ""                         -- Empty workspaces
    , ppUrgent          = underlined colorRed . xmobarColor colorRed ""           -- Urgent workspace
    , ppRename          = \ws _ -> workspaceIcon ws ++ " " ++ ws
    , ppWsSep           = " "
    , ppSep             = "  "
    , ppOrder           = \xs -> take 1 xs ++ drop 3 xs                       -- Workspaces, then the extras
    , ppExtras          = [layoutLogger s]
    }
  where
    -- A line of 3 pixels at the bottom of the bar, under the text
    underlined color = xmobarBorder "Bottom" color 3

-- Layout icon and name. Click it to change the layout.
layoutLogger :: ScreenId -> Logger
layoutLogger s = fmap (fmap label) (logLayoutOnScreen s)
  where
    label l = xmobarAction "xdotool key super+Tab" "1"
            $ xmobarColor colorBlue "" (layoutIcon l) ++ " " ++ xmobarColor colorSubtext "" l

layoutIcon :: String -> String
layoutIcon l = fromMaybe "\xf0db" (lookup l icons)
  where
    icons = [ ("tall",    "\xf0db")   -- columns
            , ("monocle", "\xf2d0")   -- window maximize
            , ("floats",  "\xf2d2")   -- window restore
            , ("grid",    "\xf00a")   -- grid
            , ("tabs",    "\xf0c9")   -- bars
            , ("Full",    "\xf065")   -- expand
            ]

------------------------------------------------------------------------
-- Main
------------------------------------------------------------------------

main :: IO ()
main = do
    -- The bars get icons, so send UTF-8 to them for all locales
    setLocaleEncoding utf8
    xmonad
     . ewmhFullscreen
     . ewmh
     . docks
     . dynamicSBs myStatusBar
     $ def
        -- New windows go to the end of the stack (on the right in "tall").
        -- insertPosition must be the first hook, so it also places the windows
        -- that other hooks move to an other workspace.
        { manageHook         = insertPosition End Newer <+> ( isFullscreen --> doFullFloat ) <+> myManageHook
        , modMask            = myModMask
        , terminal           = myTerminal
        , startupHook        = myStartupHook
        , layoutHook         = myLayoutHook
        , logHook            = markTabbed >> markTabCorners
        , workspaces         = myWorkspaces
        , borderWidth        = myBorderWidth
        , normalBorderColor  = myNormColor
        , focusedBorderColor = myFocusColor
        } `additionalKeysP` myKeys
