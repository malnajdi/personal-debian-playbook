# Managed by Ansible. Edit roles/base/templates/bashrc.j2 instead.
# ~/.bashrc reads this file at the end.

# Editor
export EDITOR={{ default_editor }}
export VISUAL={{ default_editor }}

# The rest is only for interactive shells
[[ $- == *i* ]] || return

# History
# Bash cuts the history file each time HISTFILESIZE gets a number, so
# ~/.bashrc must not set it. -1 keeps all the commands in the file.
HISTSIZE={{ bash_history_size }}
HISTFILESIZE=-1
HISTCONTROL=ignoreboth
HISTIGNORE='{{ bash_history_ignore | join(':') }}'
HISTTIMEFORMAT='%F %T  '
shopt -s histappend

# Write each command to the history file when it ends, not when the terminal
# closes. A killed terminal does not lose its commands, and new terminals
# see the commands of all terminals.
if [[ ";${PROMPT_COMMAND:-};" != *";history -a;"* ]]; then
    PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# Prompt on two lines, so the command always gets the full width:
#   ~/p/w/i/devops/ansible-playbook   main   .venv
#   ❯
# The parent directories show only their first letter. The window title (in
# the bar and the tabs layout) shows the full path. The git branch and the
# Python virtual environment show when you are in one. ❯ is red when the
# last command failed. user@host shows only over SSH.
# PS1 refers to the directory and the branch through variables, so bash does
# not run a "$(...)" that is in a directory or branch name.
{% set accent_rgb = [theme.accent[1:3], theme.accent[3:5], theme.accent[5:7]] | map('int', base=16) | join(';') %}
VIRTUAL_ENV_DISABLE_PROMPT=1
PYENV_VIRTUALENV_DISABLE_PROMPT=1
__prompt() {
    local status=$? rest=${PWD/#"$HOME"/\~} part ps=
    __prompt_dir=
    while [[ $rest == */* ]]; do
        part=${rest%%/*}
        rest=${rest#*/}
        [[ $part == .* ]] && __prompt_dir+=${part:0:2}/ || __prompt_dir+=${part:0:1}/
    done
    __prompt_dir+=$rest
    __prompt_git=
    declare -F __git_ps1 >/dev/null && __prompt_git=$(__git_ps1 '%s')

    # Window title: user@host: directory
    [[ $TERM == st* || $TERM == xterm* || $TERM == rxvt* ]] && ps+='\[\e]0;\u@\h: \w\a\]'
    [[ -n $SSH_CONNECTION ]] && ps+='\[\e[1;36m\]\u@\h\[\e[0m\] '
    ps+='\[\e[1;34m\]${__prompt_dir}\[\e[0m\]'
    [[ -n $__prompt_git ]] && ps+='  \[\e[32m\] ${__prompt_git}\[\e[0m\]'
    [[ -n $VIRTUAL_ENV ]] && ps+='  \[\e[33m\] ${VIRTUAL_ENV##*/}\[\e[0m\]'
    if (( status == 0 )); then
        ps+='\n\[\e[1;38;2;{{ accent_rgb }}m\]❯\[\e[0m\] '
    else
        ps+='\n\[\e[1;31m\]❯\[\e[0m\] '
    fi
    PS1=$ps
}

# __prompt runs first, so it gets the exit status of the command
if [[ ";${PROMPT_COMMAND:-};" != *";__prompt;"* ]]; then
    PROMPT_COMMAND="__prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# Developer tools. The playbook installs nvm, pyenv and uv; you install Pulumi
# and Rust by hand. Each tool loads only when it is installed.
# nvm: Node.js versions
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# pyenv: Python versions, with the pyenv-virtualenv plugin
export PYENV_ROOT="$HOME/.pyenv"
[ -d "$PYENV_ROOT/bin" ] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null; then
    eval "$(pyenv init - bash)"
    [ -d "$PYENV_ROOT/plugins/pyenv-virtualenv" ] && eval "$(pyenv virtualenv-init -)"
fi

# Pulumi
[ -d "$HOME/.pulumi/bin" ] && export PATH="$PATH:$HOME/.pulumi/bin"

# uv (~/.local/bin) and Rust (~/.cargo/bin)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Fuzzy finder (fzf)
#   Ctrl+R      search the history of all terminals
#   Ctrl+T      insert a file path
#   Alt+C       go to a directory
#   ** + Tab    complete paths, ssh hosts, process IDs (kill **) and more
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS="--height=50% --layout=reverse --border=rounded --info=inline-right \
--color=bg+:{{ theme.surface0 }},bg:{{ theme.base }},spinner:{{ theme.cursor }},hl:{{ theme.red }} \
--color=fg:{{ theme.text }},header:{{ theme.red }},info:{{ theme.accent }},pointer:{{ theme.cursor }} \
--color=marker:{{ theme.accent }},fg+:{{ theme.text }},prompt:{{ theme.accent }},hl+:{{ theme.red }} \
--color=selected-bg:{{ theme.surface1 }},border:{{ theme.overlay }},label:{{ theme.text }}"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git --exclude node_modules'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons {} | head -200'"
# bat uses the 16 terminal colors, so it follows the theme
export BAT_THEME=base16

# ** + Tab finds files and directories with fd
_fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1"; }
_fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1"; }

eval "$(fzf --bash)"

# Ctrl+R reads the history file again before the search, so it also finds
# the commands of the terminals that are open now.
__fzf_history_all__() {
    history -a
    history -c
    history -r
    __fzf_history__
}
bind -m emacs-standard -x '"\C-r": __fzf_history_all__'
bind -m vi-command -x '"\C-r": __fzf_history_all__'
bind -m vi-insert -x '"\C-r": __fzf_history_all__'
