# picom (compositor)
# Managed by Ansible. Edit roles/base/templates/picom.conf.j2 instead.
# Uses the window rules of picom 12 (Debian 13). See "man picom".

backend = "{{ picom_backend }}";
vsync = true;
use-ewmh-active-win = true;
detect-rounded-corners = true;
detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;
unredir-if-possible = true;

# Shadows
shadow = true;
shadow-radius = 18;
shadow-opacity = 0.45;
shadow-offset-x = -16;
shadow-offset-y = -12;
shadow-color = "{{ theme.crust }}";

# Fading
fading = true;
fade-in-step = 0.06;
fade-out-step = 0.06;
fade-delta = 5;

# Rounded corners
corner-radius = {{ picom_corner_radius }};
# Blend all windows, also windows without transparency. The corner shaders (tabs
# layout) make pixels transparent, and without blending these pixels are black.
force-win-blend = true;

# Blur behind transparent windows (bar, terminal)
blur: {
  method = "dual_kawase";
  strength = 5;
};

# Window rules. When rules match the same window, the last rule wins.
rules = (
  # Inactive windows are a little darker
  { match = "window_type = 'normal' && !focused"; dim = 0.08; },

  # Menus and tooltips: no shadow, small corners
  { match = "window_type = 'dropdown_menu' || window_type = 'popup_menu' || window_type = 'menu' || window_type = 'tooltip' || window_type = 'combo'";
    shadow = false; corner-radius = 4; blur-background = false; },

  # Launcher
  { match = "class_g = 'Rofi'"; dim = 0; corner-radius = 12; },

  # Notifications
  { match = "class_g = 'Dunst'"; corner-radius = {{ picom_corner_radius }}; },

  # Window decorations of xmonad (tabs) and the workspace name
  { match = "class_g = 'xmonad' || class_g = 'xmonad-decoration'"; shadow = false; corner-radius = 0; dim = 0; },

  # Tabs layout of xmonad: the tabs and the window under them look like one window.
  # xmonad sets _XMONAD_TABBED on the window, and _XMONAD_TAB_CORNERS on each tab
  # (1: first tab, 2: last tab, 3: the only tab). The shaders round only the outer
  # corners. Shaders need the glx or egl backend. "@" reads the property of the
  # frame window: picom 12 does not see changes of the client properties.
  { match = "_XMONAD_TABBED@ = 1"; corner-radius = 0; shadow = false;
    shader = "{{ user_config_path }}/picom/shaders/round-bottom.glsl"; },
  { match = "_XMONAD_TAB_CORNERS@ = 1";
    shader = "{{ user_config_path }}/picom/shaders/round-top-left.glsl"; },
  { match = "_XMONAD_TAB_CORNERS@ = 2";
    shader = "{{ user_config_path }}/picom/shaders/round-top-right.glsl"; },
  { match = "_XMONAD_TAB_CORNERS@ = 3";
    shader = "{{ user_config_path }}/picom/shaders/round-top.glsl"; },

  # Full screen windows (videos, games, lock screen)
  { match = "fullscreen"; corner-radius = 0; shadow = false; dim = 0; },

  # Screenshot tool: no effects and no animation, so the screen does not change
  # when you start a screenshot
  { match = "class_g = 'flameshot'"; corner-radius = 0; shadow = false; dim = 0; fade = false; blur-background = false;
    animations = ({ triggers = [ "open", "close" ]; }); },

  # Transparent applications
{% for app in picom_opacity_apps %}
  { match = "class_g = '{{ app.name }}'"; opacity = {{ app.opacity / 100 }}; },
{% endfor %}
);
{% if picom_animations %}

# Animations for windows that open and close
animations = (
  { triggers = [ "open" ]; preset = "appear"; duration = 0.18; scale = 0.92; },
  { triggers = [ "close" ]; preset = "disappear"; duration = 0.12; scale = 0.92; },
);
{% endif %}
