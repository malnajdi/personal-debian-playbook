{
    // The VSCode theme of the palette (theme_name), with the accent color of the desktop
    "workbench.colorTheme": "{{ theme.vscode_theme }}",
    "workbench.colorCustomizations": {
        "[{{ theme.vscode_theme }}]": {
            "focusBorder": "{{ theme.accent }}",
            "activityBar.activeBorder": "{{ theme.accent }}",
            "activityBarBadge.background": "{{ theme.accent }}",
            "activityBarBadge.foreground": "{{ theme.crust }}",
            "tab.activeBorder": "{{ theme.accent }}",
            "panelTitle.activeBorder": "{{ theme.accent }}",
            "statusBarItem.remoteBackground": "{{ theme.accent }}",
            "statusBarItem.remoteForeground": "{{ theme.crust }}",
            "button.background": "{{ theme.accent }}",
            "button.foreground": "{{ theme.crust }}",
            "progressBar.background": "{{ theme.accent }}",
            "editorCursor.foreground": "{{ theme.cursor }}"
        }
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "workbench.startupEditor": "none",
    "explorer.confirmDragAndDrop": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.fullScreen": false,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "editor.scrollbar.vertical": "hidden",
    "editor.minimap.enabled": false,
    "editor.fontFamily": "mononoki Nerd Font Mono",
    "zenMode.centerLayout": true,
    "workbench.action.toggleCenteredLayout": true,
}
