! Managed by Ansible
! {{ theme_name }} Xresources palette
!! COLORS

*.background:   {{ theme.base }}
*.foreground:   {{ theme.text }}
*.cursorColor:  {{ theme.cursor }}

{% set names = ['black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white'] %}
{% for name in names %}
! {{ name }}
*.color{{ loop.index0 }}:{{ ' ' if loop.index0 < 10 else '' }}      {{ theme.ansi[loop.index0] }}
*.color{{ loop.index0 + 8 }}:{{ ' ' if loop.index0 + 8 < 10 else '' }}      {{ theme.ansi[loop.index0 + 8] }}

{% endfor %}
Xft.dpi: 100
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xcursor.theme: Adwaita
Xcursor.size: 24
