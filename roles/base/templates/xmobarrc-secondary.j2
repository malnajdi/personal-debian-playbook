{#- Nerd Font icon. xmobar does not read escape codes in the template, so Jinja writes the character. -#}
{% set clock = '' %}
-- xmobar: compact bar (all screens except screen 0)
-- Managed by Ansible. Edit roles/base/templates/xmobarrc-secondary.j2 instead.
-- https://codeberg.org/xmobar/xmobar
--
-- Left:  workspaces and layout of this screen (from xmonad)
-- Right: time

Config { font            = "{{ bar_font }} {{ bar_secondary_font_size }}"
       , additionalFonts = [ "{{ bar_font }} {{ bar_secondary_font_size + 2 }}"    -- fn=1: icons
                           , "{{ bar_font }} Bold {{ bar_secondary_font_size }}"   -- fn=2: bold
                           ]
       , bgColor         = "{{ theme.base }}"
       , fgColor         = "{{ theme.text }}"
       , alpha           = {{ bar_alpha }}
       , position        = TopHM {{ bar_secondary_height }} {{ bar_margin }} {{ bar_margin }} {{ bar_margin }} 0
       , lowerOnStart    = True
       , hideOnStart     = False
       , allDesktops     = True
       , persistent      = True
       , commands = [
                      -- Workspaces and layout from xmonad.
                      -- The workspaces are 'clickable' in my configs.
                      Run UnsafeStdinReader
                      -- Time
                    , Run Date "<fn=2>%I:%M %p</fn>" "time" 50
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = " %UnsafeStdinReader% }{ <fc={{ theme.accent }}><fn=1>{{ clock }}</fn></fc> %time% "
       }
