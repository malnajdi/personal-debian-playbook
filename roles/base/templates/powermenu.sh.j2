#!/bin/sh
# Managed by Ansible
# Power menu with rofi: lock, log out, suspend, reboot, power off and power settings.

lock="{{ user_config_path }}/i3lock/lock_multi_screen.sh"

choice=$(printf '%s\n' \
    "  Lock" \
    "  Log out" \
    "  Suspend" \
    "  Reboot" \
    "  Power off" \
    "  Power settings" \
    | rofi -dmenu -i -p "Power" -theme-str 'window { width: 360px; } listview { lines: 6; }')

case "$choice" in
    *Lock)        "$lock" ;;
    *"Log out")   loginctl terminate-session "$XDG_SESSION_ID" ;;
    # xss-lock locks the screen before sleep
    *Suspend)     systemctl suspend ;;
    *Reboot)      systemctl reboot ;;
    *"Power off") systemctl poweroff ;;
    *"Power settings") exec "{{ user_config_path }}/power-settings.sh" ;;
esac
